TOKEN=
COOKIE=
DISCORD_GUILD_ID=
WATCH_CHANNEL_ID=
WALLET_OWNER_ID=1521237044746125462
POLL_INTERVAL_SECONDS=0.5
POLL_REPORT_SECONDS=60
DEBUG=false
# SAFEBUY=true waits for ≥3 sales during channel delay (skip serial #1-3); still buys if stock rushes
SAFEBUY=false
# Local: leave empty (uses ./data). Railway volume: set to mount path e.g. /data
DATA_DIR=

# Drop monitor (user token gateway)
DROP_USER_TOKEN=
DROP_USER_TOKEN_FALLBACK=
DROP_GUILD_ID=
DROP_CHANNEL_ID=
DROP_TEST_GUILD_ID=
DROP_TEST_CHANNEL_ID=
DROP_ROLE_ID=
DROP_FLAG_WAIT_SECONDS=120
DROP_SNIPE_DELAY_MS_MIN=50
DROP_SNIPE_DELAY_MS_MAX=200

# Promo code sniper (shares drop user-token monitor)
PROMO_CHANNEL_ID=1522635553575534723
PROMO_TEST_CHANNEL_ID=1547087951912239225
# Optional @Code Pings role id. When set, official channel only snipes on that ping
# (then checks ±2 messages for ALL CAPS / promocode: if the ping msg has no code).
PROMO_ROLE_ID=
